    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FontResolution.PdfSharp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageReference Include="MSTest" Version="4.5.3" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FontResolver.PdfSharp\FontResolver.PdfSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FontResolver.Tests\SyntheticFont.cs" Link="SyntheticFont.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Font Stub.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
